# Pegue sua chave gratuita em https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=coloque_sua_chave_aqui

PORT=3000

# Opcional na sua máquina, mas OBRIGATÓRIO quando hospedar (Render etc) pra os
# grupos não se perderem. Crie um banco grátis em https://upstash.com (Redis),
# depois copie "REST URL" e "REST TOKEN" da página do banco e cole abaixo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
